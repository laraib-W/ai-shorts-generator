# Redis (shared by Celery, LangGraph checkpointing, rate limiting)
REDIS_URL=redis://localhost:6379/0

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# KMS (for API key encryption)
KMS_PROVIDER=  # aws, gcp, or vault
KMS_KEY_ID=

# Pexels (free stock footage fallback)
PEXELS_API_KEY=

# App
APP_SECRET_KEY=change-me-to-a-random-string
APP_ENV=development

# JWT Auth
JWT_SECRET_KEY=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440
